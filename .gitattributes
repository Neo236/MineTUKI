# Los .toml del pack se guardan tal cual: packwiz hashea bytes, y una
# conversion de finales de linea cambiaria el hash y romperia el indice.
* -text

# Excepciones: scripts que ejecuta Linux. Con CRLF el shebang queda como
# "/bin/sh\r" y fallan con "required file not found" (exit 127).
updater/gradlew text eol=lf
.githooks/* text eol=lf

# Los .bat se entregan con finales de linea de Windows. cmd.exe recorre el
# archivo por posicion de byte: con LF solos, un "goto" o un "call :etiqueta"
# puede caer en medio de una linea y el script se rompe de formas raras.
updater/src/installer/*.bat text eol=crlf
