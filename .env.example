# Copy to .env (gitignored) and adjust as needed. Every value here has a
# sane default in docker-compose.yml if you don't set it.

MC_MEMORY=8G
# Hard container ceiling - keep a couple GB above MC_MEMORY for off-heap use
MC_MEM_LIMIT=10g
# Lo que se lee en la lista de servidores. Acepta codigos de color con §
MC_MOTD=MineTUKI
MC_DIFFICULTY=normal
MC_MAX_PLAYERS=10
MC_TZ=America/Argentina/Buenos_Aires

# Segundos que puede tardar un tick antes de que el vigilante mate el
# servidor. -1 lo desactiva, que es lo razonable con tanta generacion de
# terreno. Ponelo en 60000 si alguna vez queres el comportamiento de vanilla.
MC_MAX_TICK_TIME=-1

# Leave FALSE unless you need remote console access. If you enable it,
# also uncomment the 25575 port in docker-compose.yml.
MC_ENABLE_RCON=FALSE
MC_RCON_PASSWORD=
